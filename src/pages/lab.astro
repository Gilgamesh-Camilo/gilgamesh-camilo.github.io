---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPreview from '../components/PostPreview.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';

const allLabs = await getCollection('lab');
const labs = sortItemsByDateDesc(allLabs);
---

<BaseLayout
    title="Lab"
    description="Laboratorios prácticos de SQL avanzado, Concurrencia, PL/SQL, MongoDB y Arquitectura Políglota."
    showHeader={false}
>
    <h1 class="mb-12 text-2xl leading-tight font-serif italic sm:mb-16 sm:text-4xl">Lab</h1>
    {
        labs.length > 0 ? (
            labs.map((lab) => <PostPreview post={lab} basePath="/lab" class="mb-10 sm:mb-12" />)
        ) : (
            <p class="mb-12 text-sm">
                No hay laboratorios publicados aún en <code>src/content/lab/</code>.
            </p>
        )
    }
</BaseLayout>